# Agent Reach (Rust) 环境变量样例
# 复制为 .env 后按需填写，切勿提交真实密钥。

# X / Twitter（Cookie 认证）
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# 代理（CN 网络访问 X / Reddit 时需要）
HTTP_PROXY=
HTTPS_PROXY=

# Groq API Key（小宇宙 / 播客转录，免费：https://console.groq.com）
GROQ_API_KEY=

# 小红书同域 Cookie 集（用 Cookie-Editor 导出）
XHS_COOKIES=

# 每渠道后端覆盖（可选，等价于原版 <CHANNEL>_BACKEND）
# TWITTER_BACKEND=twitter-cli
# ZHIHU_BACKEND=jina
